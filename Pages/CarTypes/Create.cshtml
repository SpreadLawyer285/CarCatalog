@page
@model CarCatalog.Pages.CarTypes.CreateModel
@{ ViewData["Title"] = "Új típus"; }
<h1>Új típus</h1>
<form method="post" class="col-md-5">
    <div class="mb-3">
        <label asp-for="Item.BrandId" class="form-label"></label>
        <select asp-for="Item.BrandId" asp-items="Model.Brands" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Item.Name" class="form-label"></label>
        <input asp-for="Item.Name" class="form-control" />
        <span asp-validation-for="Item.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Item.Year" class="form-label"></label>
        <input asp-for="Item.Year" class="form-control" />
        <span asp-validation-for="Item.Year" class="text-danger"></span>
    </div>
    <button class="btn btn-success">Mentés</button>
    <a class="btn btn-link" asp-page="Index">Vissza</a>
</form>
